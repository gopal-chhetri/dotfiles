# set mod key
set $mod Mod4
set $mod2 Mod1

font pango:JetBrainsMono Nerd Font 10
# font pango: Hack Nerd Font 14
# font pango: Iosevka Regular 14
# font pango: DejaVu Sans Mono 14
# font pango: FiraCode Nerd Font 14


# Config about what you wants to run after you starts your system
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id nm-applet
# exec_always --no-startup-id compton -b
# exec --no-startup-id picom
exec --no-startup-id copyq
exec --no-startup-id udiskie
exec --no-startup-id dunst
exec_always --no-startup-id xinput set-prop "MSFT0002:00 04F3:31AD Touchpad" "libinput Tapping Enabled" 1
exec --no-startup-id xset s off -dpms # disbale screen-timeout

# audio ctrl
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/volume up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/volume down
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/volume mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# control brigtness
exec --no-startup-id brightnessctl set 100%
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

floating_modifier $mod
bindsym $mod+Return exec kitty
bindsym $mod2+Return exec kitty
# bindsym $mod+s exec dmenu_run
# bindsym $mod+d exec --no-startup-id i3-dmenu-desktop
bindsym $mod+s exec rofi -show drun

bindsym $mod+e exec thunar
bindsym $mod+Shift+f exec firefox-beta
bindsym $mod+Shift+b exec brave-beta
bindsym $mod+Shift+s exec spotify
bindsym $mod+Shift+c exec --no-startup-id copyq toggle

# Close focused window
bindsym $mod+Shift+q kill
bindsym $mod2+Shift+q kill
bindsym Mod1+Shift+f exec --no-startup-id killall firefox-beta
bindsym Mod1+Shift+l exec i3lock-fancy-dualmonitor
bindsym $mod+Shift+e exec rofi -show emoji
bindsym $mod+c exec rofi -show calc -no-show-match -no-sort
bindsym $mod+Shift+p exec ~/.config/polybar/launch_polybar.sh

# dunst notification keybinds
bindsym Mod1+c exec dunstctl close
bindsym Mod1+Shift+c exec dunstctl close-all
# bindsym Mod1+d exec dunstctl history-pop

## Clipboard Screenshots
bindsym --release Print exec --no-startup-id flameshot gui --clipboard
# bindsym Print exec --no-startup-id flameshot gui --raw | xclip -selection clipboard -t image/png

# Change the focus window
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+i focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
# Move the window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+i move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

# floating and layouts
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+w layout tabbed
bindsym $mod+Shift+w layout toggle split

# Disable the titlebar
default_border pixel 0
default_floating_border pixel 0
# Set the gaps
gaps inner 2
gaps outer 2

# Config about the workspace
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $ws11 "11"
set $ws12 "12"
set $ws13 "13"
set $ws14 "14"
set $ws15 "15"
set $ws16 "16"
set $ws17 "17"
set $ws18 "18"
set $ws19 "19"
set $ws20 "20"

# Assign workspaces:
assign [class="^discord$"] $ws11
assign [class="Slack"] $ws12
assign [class="Vivaldi"] $ws13
assign [class="Postman"] $ws14
assign [class="Apidog"] $ws14
assign [class="NoSQLBooster"] $ws15
assign [class="Spotify"] $ws20
assign [class="TopTracker"] $ws19
assign [class="^Brave"] $ws3
# assign [class="Antigravity"] $ws4
# assign [class="Windsurf"] $ws3
# assign [class="^Code"] $ws4

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod2+1 workspace number $ws11
bindsym $mod2+2 workspace number $ws12
bindsym $mod2+3 workspace number $ws13
bindsym $mod2+4 workspace number $ws14
bindsym $mod2+5 workspace number $ws15
bindsym $mod2+6 workspace number $ws16
bindsym $mod2+7 workspace number $ws17
bindsym $mod2+8 workspace number $ws18
bindsym $mod2+9 workspace number $ws19
bindsym $mod2+0 workspace number $ws20

# move container between workspaces
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod2+Shift+1 move container to workspace number $ws11
bindsym $mod2+Shift+2 move container to workspace number $ws12
bindsym $mod2+Shift+3 move container to workspace number $ws13
bindsym $mod2+Shift+4 move container to workspace number $ws14
bindsym $mod2+Shift+5 move container to workspace number $ws15
bindsym $mod2+Shift+6 move container to workspace number $ws16
bindsym $mod2+Shift+7 move container to workspace number $ws17
bindsym $mod2+Shift+8 move container to workspace number $ws18
bindsym $mod2+Shift+9 move container to workspace number $ws19
bindsym $mod2+Shift+0 move container to workspace number $ws20
# cycle between workspace
bindsym $mod+Ctrl+n     workspace next
bindsym $mod+Ctrl+p     workspace prev
bindsym $mod+Tab        workspace next
bindsym $mod+Shift+Tab  workspace prev
bindsym $mod+Ctrl+Right workspace next
bindsym $mod+Ctrl+Left  workspace prev

# i3 reload restart and exit
# bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
# bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Resize the window
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym i resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# manage workspaces in multiple monwitor setups
set $fm eDP-1
set $sm HDMI-1-0
workspace $ws1 output $fm
workspace $ws2 output $fm
workspace $ws3 output $fm
workspace $ws4 output $fm
workspace $ws5 output $fm
workspace $ws6 output $fm
workspace $ws7 output $fm
workspace $ws8 output $fm
workspace $ws9 output $fm
workspace $ws10 output $fm
workspace $ws11 output $sm
workspace $ws12 output $sm
workspace $ws13 output $sm
workspace $ws14 output $sm
workspace $ws15 output $sm
workspace $ws16 output $sm
workspace $ws17 output $sm
workspace $ws18 output $sm
workspace $ws19 output $sm
workspace $ws20 output $sm
exec_always --no-startup-id sh -c 'xrandr -q | grep -q "^HDMI-1-0 connected" && ~/.screenlayout/dualmonitor.sh || ~/.screenlayout/single_monitor.sh'

exec_always --no-startup-id nitrogen --restore
exec_always --no-startup-id ~/.config/polybar/launch_polybar.sh

