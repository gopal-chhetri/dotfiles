#!/usr/bin/env python3
# Small volume slider that pops up under the polybar volume module.
# Closes on Escape or when it loses focus.
import re
import subprocess

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gtk

SINK = "@DEFAULT_SINK@"
WIDTH = 220
BAR_HEIGHT = 20  # polybar is 20pt tall at the top; open just below it

# Catppuccin Mocha, matching kitty/current-theme.conf
# window { background-color: #1e1e2e; border: 1px solid #b4befe; }
CSS = b"""
window { background-color: #1e1e2e; }
scale { color: #cdd6f4; font-family: "JetBrainsMono Nerd Font Mono"; }
scale trough { background-color: #313244; border: none; border-radius: 3px; min-height: 6px; }
scale highlight { background-color: #89b4fa; border: none; border-radius: 3px; }
scale slider { background: #cdd6f4; border: none; box-shadow: none; min-width: 14px; min-height: 14px; border-radius: 7px; }
scale slider:hover { background: #b4befe; }
scale value { color: #cdd6f4; }
"""


def pactl(*args):
    return subprocess.run(["pactl", *args], capture_output=True, text=True).stdout


def set_volume(scale):
    pactl("set-sink-mute", SINK, "0")
    pactl("set-sink-volume", SINK, f"{int(scale.get_value())}%")


css = Gtk.CssProvider()
css.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
)

current = int(re.search(r"(\d+)%", pactl("get-sink-volume", SINK)).group(1))

win = Gtk.Window(title="Volume")
win.set_decorated(False)
win.set_type_hint(Gdk.WindowTypeHint.DIALOG)  # i3 floats dialogs
win.set_default_size(WIDTH, -1)
win.set_border_width(8)

scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
scale.set_value(min(current, 100))
scale.set_value_pos(Gtk.PositionType.RIGHT)
scale.connect("value-changed", set_volume)
win.add(scale)

# Center the slider under the mouse, kept inside the monitor
display = Gdk.Display.get_default()
_, x, _ = display.get_default_seat().get_pointer().get_position()
mon = display.get_monitor_at_point(x, 0).get_geometry()
x = max(mon.x, min(x - WIDTH // 2, mon.x + mon.width - WIDTH))
win.move(x, mon.y + BAR_HEIGHT)

win.connect("focus-out-event", lambda *_: Gtk.main_quit())
win.connect(
    "key-press-event", lambda _, e: e.keyval == Gdk.KEY_Escape and Gtk.main_quit()
)
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
