#!/bin/sh

# Increment, decrement, or mute the volume using pactl and send a notification
# (pactl talks to PipeWire through pipewire-pulse)

SINK=@DEFAULT_SINK@
MAX=200

get_volume() {
	pactl get-sink-volume "$SINK" | grep -o '[0-9]*%' | head -n 1 | tr -d %
}

case $1 in
	up)
		# Set the volume on (if it was muted)
		pactl set-sink-mute "$SINK" 0
		# pactl has no upper limit, so cap at $MAX% by hand
		NEW=$(( $(get_volume) + 5 ))
		[ "$NEW" -gt "$MAX" ] && NEW=$MAX
		pactl set-sink-volume "$SINK" "${NEW}%"
		;;
	down)
		pactl set-sink-mute "$SINK" 0
		pactl set-sink-volume "$SINK" -5%
		;;
	mute)
		pactl set-sink-mute "$SINK" toggle
		;;
esac

VOLUME=$(get_volume)


send_notification() {
	if [ "$1" = "mute" ]; then ICON="mute"; elif [ "$VOLUME" -lt 33 ]; then ICON="low"; elif [ "$VOLUME" -lt 66 ]; then ICON="medium"; else ICON="high"; fi
	if [ "$1" = "mute" ]; then TEXT="Currently muted"; else TEXT="Currently at ${VOLUME}%"; fi

	dunstify -a "Volume" -r 9993 -h int:value:"$VOLUME" -i "volume-$ICON" "Volume" "$TEXT" -t 2000
}

case $1 in
	mute)
		case "$(pactl get-sink-mute "$SINK")" in
			*yes* ) send_notification mute;;
			*     ) send_notification;;
		esac;;
	*)
		send_notification;;
esac
